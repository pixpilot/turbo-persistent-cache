{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug cache server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "cwd": "${workspaceRoot}",
      "args": ["tsx", "src/dev-run.ts"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "node_modules/**"]
    }
  ]
}
