{
  "$schema": "https://unpkg.com/@pixpilot/scaffoldfy@latest/schema/scaffoldfy.schema.json",
  "extends": [
    "https://unpkg.com/@pixpilot/scaffoldfy-configs@latest/setup-guard/scaffoldfy.json",
    "https://unpkg.com/@pixpilot/scaffoldfy-configs@latest/project-info/scaffoldfy.json",
    "https://unpkg.com/@pixpilot/scaffoldfy-configs@latest/pixpilot-info/scaffoldfy.json",
    "https://unpkg.com/@pixpilot/scaffoldfy-configs@latest/license-file/scaffoldfy.json",
    "https://unpkg.com/@pixpilot/scaffoldfy-configs@latest/update-root-package-json/scaffoldfy.json",
    "https://unpkg.com/@pixpilot/scaffoldfy-configs@latest/security-policy/scaffoldfy.json"
  ],
  "name": "pnpm-turbo-monorepo-template-setup-local",
  "description": "Runs setup tasks without modifying README.md, GitHub workflows, or adding the package-section generator.",
  "prompts": [],
  "tasks": [
    {
      "id": "reset-package-version",
      "name": "Reset package version",
      "description": "Reset the root package version for the newly scaffolded project.",
      "type": "update-json",
      "config": {
        "file": "package.json",
        "updates": {
          "version": "0.0.0"
        }
      }
    },
    {
      "id": "update-description",
      "name": "Update package description",
      "description": "Update the root package description for the newly scaffolded project.",
      "type": "update-json",
      "config": {
        "file": "package.json",
        "updates": {
          "description": "{{projectName}}"
        }
      }
    },
    {
      "id": "update-contributing",
      "name": "Update CONTRIBUTING.md",
      "description": "Update contributing guidelines with project information.",
      "type": "replace-in-file",
      "config": {
        "file": "CONTRIBUTING.md",
        "replacements": [
          {
            "find": "<projectName>",
            "replace": "{{projectName}}"
          }
        ]
      }
    },

    {
      "id": "reinstall-dependencies",
      "name": "Reinstall dependencies",
      "description": "Reinstall dependencies after setup cleanup.",
      "type": "exec",
      "config": {
        "command": "pnpm install"
      }
    },
    {
      "id": "delete-setup-folder",
      "name": "Delete setup folder",
      "description": "Remove setup assets after setup-guard has stripped their call sites.",
      "type": "delete",
      "config": {
        "paths": ["setup"]
      }
    }
  ]
}
