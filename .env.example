# Settings for running the cache server locally (`pnpm turbogha start`,
# `pnpm dev-run`, `pnpm cleanup`). Copy to `.env` and adjust.
# Do not commit your actual .env file to Git! It may contain secrets.

# Cache provider: github or s3. Outside GitHub Actions the github provider
# stores artifacts on the local filesystem (RUNNER_TEMP, or /tmp).
PROVIDER=github

# Optional: prefix for cache keys (default: turbogha_)
# CACHE_PREFIX=turbogha_

# Optional: server port (default: 41230, 0 = pick a free port)
# SERVER_PORT=41230

# Optional: print debug logs and per-operation timings
# LOG_LEVEL=debug

# S3 provider settings (only used when PROVIDER=s3)
# AWS_ACCESS_KEY_ID=         # or S3_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=     # or S3_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=         # or S3_SESSION_TOKEN, for temporary credentials
# AWS_REGION=us-east-1       # or AWS_DEFAULT_REGION / S3_REGION
# AWS_ENDPOINT_URL_S3=https://s3.amazonaws.com  # or AWS_ENDPOINT_URL / S3_ENDPOINT
# S3_BUCKET=my-bucket
# S3_PREFIX=turbogha/

# S3 cleanup limits (S3 provider only)
# MAX_AGE=2w
# MAX_FILES=300
# MAX_SIZE=5gb
